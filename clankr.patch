+
+    // ─── Dyson swarm: physics-based activity ring around the AI avatar ───
+    // The logo is the "star"; 32 nodes live on a spherical shell around it.
+    //   orbit : shell rotates steadily, held near the star       (model generating)
+    //   exec  : nodes are repulsed outward & held at a distance,
+    //           rotation damps to a near-standstill              (tool running)
+    //   wait  : slow uneasy orbit, amber                         (approval needed)
+    //   done/error : the swarm dissolves.
+    // All transitions run through the force simulation (damped radial spring +
+    // smoothed angular velocity) — nothing snaps. One shared rAF loop serves
+    // every active avatar; it stops when no avatar is animating.
+    const DysonSwarm = (() => {
+      const N = 32, TILT = -0.42;
+      const CFG = {orbit: {R: .82, w: .55}, exec: {R: 1.10, w: .06}, wait: {R: .82, w: .16},
+                   done: {R: .82, w: .30}, error: {R: .82, w: .30}};
+      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
+      const live = new Set();
+      let raf = 0, last = 0, paused = false;
+
+      function fibSphere(n) {          // even node layout on the unit sphere
+        const pts = [], ga = Math.PI * (3 - Math.sqrt(5));
+        for (let i = 0; i < n; i++) {
+          const y = 1 - (i / Math.max(1, n - 1)) * 2;
+          const r = Math.sqrt(Math.max(0, 1 - y * y)), t = ga * i;
+          pts.push([Math.cos(t) * r, y, Math.sin(t) * r]);
+        }
+        return pts;
+      }
+      function rotTilt(p, a) {         // orbit around Y, then tilt the camera so it reads 3D
+        const [x, y, z] = p, ca = Math.cos(a), sa = Math.sin(a);
+        const rx = x * ca + z * sa, rz = -x * sa + z * ca;
+        const ct = Math.cos(TILT), st = Math.sin(TILT);
+        return [rx, y * ct - rz * st, y * st + rz * ct];
+      }
+      function accentColor() {
+        const h = getComputedStyle(document.documentElement).getPropertyValue('--hue').trim() || '100';
+        return `hsl(${h} 60% 68%)`;
+      }
+
+      function attach(avatar) {
+        let cv = avatar.querySelector('.swarm-cv');
+        if (!cv) {cv = document.createElement('canvas'); cv.className = 'swarm-cv'; cv.setAttribute('aria-hidden', 'true'); avatar.prepend(cv);}
+        const c2 = cv.getContext('2d');
+        const S = Math.round(avatar.getBoundingClientRect().width) || 40;
+        const pad = Math.round(S * .85);          // swarm may extend past the disc when "held"
+        const dpr = Math.min(devicePixelRatio || 1, 2);
+        cv.width = (S + pad * 2) * dpr; cv.height = (S + pad * 2) * dpr;
+        cv.style.width = cv.style.height = (S + pad * 2) + 'px';
+        cv.style.left = cv.style.top = -pad + 'px';
+        const CS = S + pad * 2, CX = CS / 2, CY = CS / 2, AR = S / 2;
+        const pts = fibSphere(N), links = [];
+        const maxD = 2.2 / Math.sqrt(N);           // link spacing shrinks as nodes increase
+        for (let i = 0; i < N; i++) for (let j = i + 1; j < N; j++) {
+          const a = pts[i], b = pts[j];
+          const d = Math.hypot(a[0]-b[0], a[1]-b[1], a[2]-b[2]);
+          if (d < maxD) links.push([i, j, d / maxD]);
+        }
+        let mode = 'orbit', R = .78 * AR, Rv = 0, rot = 0, w = 0, alpha = 1, dying = false, dead = false;
+        let accent = accentColor();
+
+        const api = {
+          setMode(m) {
+            mode = m; dying = (m === 'done' || m === 'error');
+            if (!dying) {alpha = 1; dead = false;}
+            accent = m === 'error' ? '#e5645b' : m === 'wait' ? '#e0b04a' : accentColor();
+            if (reduced.matches) {api.staticFrame(); live.delete(api); return;}
+            live.add(api); ensureLoop();
+          },
+          kill() {live.delete(api);},
+          isDead() {return dead;},
+          step(dt) {
+            const t = CFG[mode] || CFG.orbit;
+            const k = 30, damp = 6.2;                // slightly underdamped: exec "pops" outward
+            Rv += (t.R * AR - R) * k * dt - Rv * damp * dt;
+            R += Rv * dt;
+            w += (t.w - w) * Math.min(1, dt * 2.6);   // smoothed angular velocity
+            rot += w * dt;
+            if (dying) {alpha = Math.max(0, alpha - dt * 1.8); if (alpha === 0) dead = true;}
