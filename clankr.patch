+    // ─── model picker: Family / Model / Size ───
+    // #modelSelect stays the value store (raw Ollama id in .value). This UI only
+    // reflects it. Family SVGs: icons/family-<key>.svg, else a letter monogram.
+    // Do not put data-icon on these nodes — fillIcons() replaces that node's
+    // whole innerHTML and would wipe the Family / Model / Size labels.
+    let paintModelPicker = function () {};
+    function familyMonogram(label) {
+      const ch = ((String(label).match(/[A-Za-z0-9]/) || ['?'])[0]).toUpperCase();
+      return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><text x="12" y="16" text-anchor="middle" font-size="11" font-family="ui-monospace,monospace" fill="currentColor" stroke="none">${ch}</text></svg>`;
+    }
+    function initModelPicker() {
+      const root = document.getElementById('modelPicker');
+      if (!root || root.dataset.ready) return;
+      root.dataset.ready = '1';
+      const levels = ['family', 'model', 'size'];
+      const menus = {}, buttons = {};
+      levels.forEach(level => {
+        const wrap = root.querySelector(`.mp[data-level="${level}"]`);
+        menus[level] = wrap.querySelector('.mp-menu');
+        buttons[level] = wrap.querySelector('.mp-btn');
+        buttons[level].addEventListener('click', () => {
+          if (menus[level].hidden) openMenu(level);
+          else closeMenus();
+        });
+      });
+      function entries() {
+        return [...modelSel.options].filter(o => o.value).map(o => ({
+          name: o.value,
+          family: o.dataset.family || 'other',
+          familyLabel: o.dataset.familyLabel || 'Other',
+          model: o.dataset.model || 'Base',
+          size: o.dataset.size || 'Latest',
+        }));
+      }
+      function current() {
+        return entries().find(e => e.name === modelSel.value) || entries()[0] || null;
+      }
+      function byNum(a, b, pick) {
+        return pick(a).localeCompare(pick(b), undefined, {numeric: true});
+      }
+      function sizeRank(s) {
+        const m = String(s).match(/(\d+(?:\.\d+)?)/);
+        return m ? parseFloat(m[1]) : 1e9;
+      }
+      function prefer(list, cur) {
+        return list.find(x => x.model === cur.model && x.size === cur.size)
+          || list.find(x => x.model === cur.model)
+          || list.find(x => x.size === cur.size)
+          || list[0];
+      }
+      function optionsFor(level, cur) {
+        const all = entries();
+        if (!cur) return [];
+        if (level === 'family') {
+          const seen = new Map();
+          all.forEach(e => { if (!seen.has(e.family)) seen.set(e.family, e); });
+          return [...seen.values()]
+            .sort((a, b) => byNum(a, b, e => e.familyLabel))
+            .map(e => ({
+              label: e.familyLabel,
+              key: e.family,
+              selected: e.family === cur.family,
+              pick: prefer(all.filter(x => x.family === e.family), cur).name,
+            }));
+        }
+        if (level === 'model') {
+          const inFam = all.filter(e => e.family === cur.family);
+          const seen = new Map();
+          inFam.forEach(e => { if (!seen.has(e.model)) seen.set(e.model, e); });
+          return [...seen.values()]
+            .sort((a, b) => byNum(a, b, e => e.model))
+            .map(e => ({
+              label: e.model,
+              selected: e.model === cur.model,
+              pick: (inFam.find(x => x.model === e.model && x.size === cur.size)
+                || inFam.find(x => x.model === e.model)).name,
+            }));
+        }
+        const sizes = all.filter(e => e.family === cur.family && e.model === cur.model);
+        const dup = {};
+        sizes.forEach(e => { dup[e.size] = (dup[e.size] || 0) + 1; });
+        return sizes
+          .slice()
+          .sort((a, b) => sizeRank(a.size) - sizeRank(b.size) || a.size.localeCompare(b.size))
+          .map(e => ({
+            label: dup[e.size] > 1 ? e.size + ' · ' + e.name : e.size,
+            selected: e.name === cur.name,
+            pick: e.name,
+          }));
+      }
+      function iconBody(key) {
+        return iconSvg[key] || ICON_FALLBACK[key] || '';
+      }
+      function closeMenus() {
+        levels.forEach(level => {
+          menus[level].hidden = true;
+          buttons[level].setAttribute('aria-expanded', 'false');
+        });
+      }
+      function choose(name) {
+        if (!name || ![...modelSel.options].some(o => o.value === name)) return;
+        modelSel.value = name;
+        closeMenus();
+        paintModelPicker();
+      }
+      function openMenu(level) {
+        closeMenus();
+        const cur = current();
+        const items = optionsFor(level, cur);
+        const menu = menus[level];
+        menu.innerHTML = '';
+        if (!items.length) {
+          const empty = document.createElement('li');
+          empty.className = 'mp-empty';
+          empty.textContent = 'No models';
+          menu.append(empty);
+        }
+        items.forEach((item, i) => {
+          const li = document.createElement('li');
+          li.setAttribute('role', 'option');
+          li.tabIndex = -1;
+          li.setAttribute('aria-selected', item.selected ? 'true' : 'false');
+          if (item.selected) li.classList.add('mp-on');
+          if (level === 'family') {
+            const ic = document.createElement('span');
+            ic.className = 'mp-fam';
+            ic.dataset.familyIcon = 'family-' + item.key;
+            ic.innerHTML = iconBody('family-' + item.key);
+            const tx = document.createElement('span');
+            tx.textContent = item.label;
+            li.append(ic, tx);
+          } else {
+            li.textContent = item.label;
+          }
+          li.addEventListener('click', () => choose(item.pick));
+          li.addEventListener('keydown', ev => {
+            const rows = [...menu.querySelectorAll('[role="option"]')];
+            const idx = rows.indexOf(li);
+            if (ev.key === 'ArrowDown' || ev.key === 'ArrowUp') {
+              ev.preventDefault();
+              const next = rows[idx + (ev.key === 'ArrowDown' ? 1 : -1)];
+              if (next) { rows.forEach(r => r.classList.remove('mp-on')); next.classList.add('mp-on'); next.focus(); }
+            } else if (ev.key === 'Enter') {
+              ev.preventDefault();
+              choose(item.pick);
+            } else if (ev.key === 'Escape') {
+              ev.preventDefault();
+              closeMenus();
+              buttons[level].focus();
+            } else if (ev.key === 'Tab') {
+              closeMenus();
+            }
+          });
+          menu.append(li);
+          if (item.selected) menu._focus = li;
+        });
+        menu.hidden = false;
+        buttons[level].setAttribute('aria-expanded', 'true');
+        (menu._focus || menu.querySelector('[role="option"]'))?.focus();
+      }
+      buttons.family.addEventListener('keydown', e => onBtnKey(e, 'family'));
+      buttons.model.addEventListener('keydown', e => onBtnKey(e, 'model'));
