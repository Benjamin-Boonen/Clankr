    "def plot_exp(x, intensiteit):\n",
    "    _, ax = plt.subplots()\n",
    "    ax.scatter(x, intensiteit, label='experimentele data met foutenbalken')\n",
    "    plt.errorbar(x, intensiteit, yerr=sigma, fmt='none', ecolor='black', alpha=0.5, capsize=2)\n",
    "    ax.set_xlabel('Positie [mm]')\n",
    "    ax.set_ylabel('Intensiteit [a.u.]')\n",
    "    ax.legend()\n",
    "plot_exp(x, intensiteit)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "af28476c",
   "metadata": {},
   "outputs": [],
   "source": [
    "#dit doet echt helemaal niks maar het staat er wel dus ja te laat :shrug: \n",
    "def lorenz(x, A, x0, gamma, y0):\n",
    "    return (A*gamma)/(np.pi*((x-x0)**2 + gamma**2)) + y0\n"
   ]
  },
