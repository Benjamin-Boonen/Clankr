    "import numpy as np \n",
    "from scipy.optimize import minimize, fsolve\n",
    "from scipy.stats import chi2 as chi2\n",
    "import matplotlib.pyplot as plt\n",
    "data = np.loadtxt('10.txt').T\n",
    "x = data[0]\n",
    "intensiteit = data[1]\n",
    "sigma = np.sqrt(intensiteit) # poissonverdeling"
   ]
  },
