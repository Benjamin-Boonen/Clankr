    "#is mijn fit goed of lowkey dogshit?\n",
    "start = [A_gok, x0_gok, gamma_gok, y0_gok]\n",
    "def chi2_fit(params, x, intensiteit, sigma): \n",
    "    model = lorenz(x, *params) #modelintensiteit berekenen\n",
    "    afwijking_insigma = (intensiteit - model) / sigma #checken if gucci or not\n",
    "    return np.sum(afwijking_insigma**2) #kwadraat zodat geen - en grote fouten groter doortellen\n",
    "resultaat = minimize(chi2_fit, start, args=(x, intensiteit, sigma), bounds=[(0, None), (x.min(), x.max()), (1e-12, None), (None, None)],)\n",
