   ],
   "source": [
    "#eerste gok voor gamama\n",
    "halve_hoogte = y0_gok + (np.max(intensiteit) - y0_gok) / 2 #intensiteit van x0 +- gamma\n",
    "# Meetpunten links van het geschatte midden\n",
    "x_links_data = x[x < x0_gok]\n",
    "I_links_data = intensiteit[x < x0_gok]\n",
    "\n",
    "# Eerste punt links >= de halve hoogte komt.\n",
    "# Het punt ervoor dus < halve hoogte.\n",
    "j_links = np.where(I_links_data >= halve_hoogte)[0][0]\n",
    "\n",
    "# De twee meetpunten die de halve hoogte insluiten -> intrapolatie (of extrapolatie idk lowky)\n",
    "xL1, xL2 = float(x_links_data[j_links - 1]), float(x_links_data[j_links])\n",
    "IL1, IL2 = float(I_links_data[j_links - 1]), float(I_links_data[j_links])\n",
    "\n",
    "# Meetpunten rechts van het geschatte midden\n",
    "x_rechts_data = x[x > x0_gok]\n",
    "I_rechts_data = intensiteit[x > x0_gok]\n",
    "\n",
    "# Eerste punt rechts <= halve hoogte komt.\n",
    "# Het punt ervoor > halve hoogte.\n",
    "j_rechts = np.where(I_rechts_data <= halve_hoogte)[0][0]\n",
    "\n",
    "# De twee meetpunten die de halve hoogte insluiten\n",
    "xR1, xR2 = float(x_rechts_data[j_rechts - 1]), float(x_rechts_data[j_rechts])\n",
    "IR1, IR2 = float(I_rechts_data[j_rechts - 1]), float(I_rechts_data[j_rechts])\n",
    "\n",
    "# Positie van de halve hoogte schatten door interplatie(?)\n",
    "x_links_half = xL1 + (halve_hoogte - IL1) * (xL2 - xL1) / (IL2 - IL1)\n",
    "x_rechts_half = xR1 + (halve_hoogte - IR1) * (xR2 - xR1) / (IR2 - IR1)\n",
    "\n",
    "print(\"halve hoogte:\", halve_hoogte)\n",
    "print(\"links ingesloten door:\", (xL1, IL1), \"en\", (xL2, IL2)) \n",
    "print(\"rechts ingesloten door:\", (xR1, IR1), \"en\", (xR2, IR2))\n",
    "print(\"geschatte x-waarde:\", x_links_half, \"en\", x_rechts_half)\n",
    "\n",
    "#verschil met x0 en dan gemiddelde voor gamma gok\n",
    "gamma_gok = (x_rechts_half - x_links_half) / 2  \n",
    "print(\"gamma gok:\", gamma_gok) "
   ]
