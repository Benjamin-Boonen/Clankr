   "source": [
    "#gokken x0,y0\n",
    "x0_gok = x[np.argmax(intensiteit)]\n",
    "y0_gok = np.median(np.r_[intensiteit[:5], intensiteit[-5:]]) #samennemen eerste en laatste 5 waarden tegen utischieters\n",
    "print(x0_gok, y0_gok, sigma[:5])"
